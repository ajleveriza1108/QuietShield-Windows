<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</MSBuildProjectExtensionsPath>
    <BaseIntermediateOutputPath Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('_wpftmp'))">$(MSBuildThisFileDirectory)artifacts\obj\QuietShield.App\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('_wpftmp'))">$(MSBuildThisFileDirectory)artifacts\obj\QuietShield.App\</MSBuildProjectExtensionsPath>
    <QuietShieldVersion>0.12.0-beta.1</QuietShieldVersion>
    <Version>$(QuietShieldVersion)</Version>
    <AssemblyVersion>0.12.0.0</AssemblyVersion>
    <FileVersion>0.12.0.0</FileVersion>
    <InformationalVersion>$(QuietShieldVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
