<Window x:Class="QuietShield.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QuietShield Windows"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AutomationProperties.Name="QuietShield Windows Foundation">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource NavigationBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,24,20,18">
                    <TextBlock FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="QuietShield Windows" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding VersionText}" />
                    <Border Margin="0,16,0,0"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="12">
                        <TextBlock Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   Text="FOUNDATION MODE" />
                    </Border>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="QuietShield feature navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Margin="20"
                        Padding="12"
                        Background="#17232E"
                        CornerRadius="8">
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="System tray foundation present but inactive. Automatic startup is not registered." />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="34,28,34,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,20">
                <TextBlock FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding SelectedPage.Title}" />
                <TextBlock Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding SelectedPage.Description}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Grid>
                    <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Margin="0,0,0,20"
                                Padding="18"
                                Background="{StaticResource DangerSurfaceBrush}"
                                BorderBrush="#714348"
                                BorderThickness="1"
                                CornerRadius="10"
                                AutomationProperties.Name="Protection inactive warning">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Text="Protection engines are not active" />
                                <TextBlock Margin="0,7,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="This foundation does not change Windows Firewall, DNS, adapters, services, startup, or filtering settings." />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="PROTECTION STATE" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding ProtectionState}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="ACTIVE PROFILE" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Text="{Binding ActiveProfile}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="NETWORK — READ ONLY" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding NetworkSummary}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" Text="LICENCE STATE" />
                                    <TextBlock Margin="0,10,0,0"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Text="{Binding LicenseSummary}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="17"
                                           FontWeight="SemiBold"
                                           Text="Honest foundation status" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="No protection statistics are displayed because no protection engine is active and no validated activity data exists." />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding TraySummary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsFeaturePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Style="{StaticResource CardStyle}" Margin="0">
                            <StackPanel>
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="Foundation placeholder" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="15"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="{Binding SelectedPage.Description}" />
                                <Border Margin="0,22,0,0"
                                        Padding="14"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="8">
                                    <TextBlock Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Text="This feature is intentionally inactive. Its implementation requires a separately reviewed phase with explicit safety, backup, verification, rollback, and recovery design." />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Padding="14,10"
                    Background="{StaticResource SurfaceRaisedBrush}"
                    CornerRadius="8">
                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="Safety boundary: QuietShield is currently a read-only application foundation. No Windows network or security setting is changed." />
            </Border>
        </Grid>
    </Grid>
</Window>
