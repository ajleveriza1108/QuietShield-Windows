<Window x:Class="QuietShield.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:QuietShield.App.Controls"
        xmlns:pages="clr-namespace:QuietShield.App.Pages"
        mc:Ignorable="d"
        Title="QuietShield Windows"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Continue"
        AutomationProperties.Name="QuietShield Windows Foundation">
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationPane"
                Grid.Column="0"
                Background="{StaticResource NavigationBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="12,14,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="QuietShield Windows" TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="{Binding VersionText}" />
                        <Border Margin="0,9,0,0" Style="{StaticResource StatusBadgeStyle}">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="FOUNDATION MODE" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="24"
                               Foreground="{StaticResource AccentBrush}"
                               Text="&#xEA18;"
                               ToolTip="QuietShield Windows - Foundation Mode"
                               Visibility="{Binding IsNavigationCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="NavigationToggle"
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnNavigationToggleClick"
                            Content="&#xE700;"
                            ToolTip="Expand or collapse navigation"
                            AutomationProperties.Name="Expand or collapse navigation" />
                </Grid>

                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsTabStop="True"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="QuietShield feature navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                           Text="{Binding Glyph}" />
                                <StackPanel Grid.Column="1"
                                            Margin="5,0,0,0"
                                            Visibility="{Binding DataContext.IsNavigationExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Margin="10" Padding="10" Background="{StaticResource DisabledSurfaceBrush}" CornerRadius="7">
                    <Grid>
                        <TextBlock FontSize="10"
                                   Style="{StaticResource ExplanatoryTextStyle}"
                                   Text="System tray foundation is present but inactive. Automatic startup is not registered."
                                   Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   Text="&#xE7E7;"
                                   ToolTip="System tray foundation is inactive; automatic startup is not registered."
                                   Visibility="{Binding IsNavigationCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <controls:ResponsivePageShell x:Name="PageShell"
                                      Grid.Column="1"
                                      Margin="24"
                                      Title="{Binding SelectedPage.Title}"
                                      Description="{Binding SelectedPage.Description}"
                                      StatusText="{Binding SelectedPage.Status}">
            <controls:ResponsivePageShell.PageContent>
                <Grid>
                    <pages:DashboardPage Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:ProgramConnectionLockPage Visibility="{Binding IsProgramConnectionLock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:ProtectionProfilesPage Visibility="{Binding IsProtectionProfiles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:SchedulesPage Visibility="{Binding IsSchedules, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:CompatibilityGuardPage Visibility="{Binding IsCompatibilityGuard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:DnsProtectionPage Visibility="{Binding IsDnsProtection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:DnsListsPage Visibility="{Binding IsDnsLists, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <pages:FoundationStatusPages />
                </Grid>
            </controls:ResponsivePageShell.PageContent>
        </controls:ResponsivePageShell>
    </Grid>
</Window>
