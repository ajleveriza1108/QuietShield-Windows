<Window x:Class="QuietShield.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:QuietShield.App.Controls"
        xmlns:pages="clr-namespace:QuietShield.App.Pages"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="QuietShield Windows"
        Width="1365"
        Height="820"
        MinWidth="960"
        MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackdropBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        KeyboardNavigation.TabNavigation="Continue"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        AutomationProperties.Name="QuietShield Windows">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackdropBrush}"
            BorderBrush="{StaticResource GlassStrokeSoftBrush}"
            BorderThickness="1"
            CornerRadius="13">
        <Grid x:Name="RootLayout">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Background="#D80A1321"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="13,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="23"
                            Height="23"
                            Margin="0,0,8,0"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="{StaticResource InformationBrush}"
                                   Text="&#xEA18;" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="QuietShield Windows" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,4,5,4"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMinimizeClick"
                            Content="&#xE921;"
                            ToolTip="Minimize" />
                    <Button Style="{StaticResource CaptionButtonStyle}"
                            Click="OnMaximizeRestoreClick"
                            Content="&#xE922;"
                            ToolTip="Maximize or restore" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}"
                            Click="OnCloseClick"
                            Content="&#xE8BB;"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>

            <Border x:Name="NavigationPane"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="8,0,0,8"
                    Background="{StaticResource SidebarBackdropBrush}"
                    BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Expanded header. -->
                    <Grid Margin="12,10,9,8"
                          Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="42"
                                Height="42"
                                MouseLeftButtonUp="OnBrandMouseLeftButtonUp"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource GlassStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                ToolTip="QuietShield - click to collapse navigation">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="{StaticResource InformationBrush}"
                                       Text="&#xEA18;" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="9,2,0,0">
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="QuietShield" />
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Windows" />
                        </StackPanel>

                        <Button x:Name="NavigationToggle"
                                Grid.Column="2"
                                Margin="6,1,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource IconButtonStyle}"
                                Click="OnNavigationToggleClick"
                                Content="&#xE700;"
                                ToolTip="Collapse navigation (Ctrl+B)"
                                AutomationProperties.Name="Collapse navigation" />
                    </Grid>

                    <!-- Compact header: hamburger is always reachable. -->
                    <StackPanel Margin="7,8,7,7"
                                Visibility="{Binding IsNavigationCompact, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="CompactNavigationToggle"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource IconButtonStyle}"
                                Click="OnNavigationToggleClick"
                                Content="&#xE700;"
                                ToolTip="Expand navigation (Ctrl+B)"
                                AutomationProperties.Name="Expand navigation" />
                        <Border Width="38"
                                Height="38"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                MouseLeftButtonUp="OnBrandMouseLeftButtonUp"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                ToolTip="QuietShield - click to expand navigation">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="21"
                                       Foreground="{StaticResource InformationBrush}"
                                       Text="&#xEA18;" />
                        </Border>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Grid.Row="1"
                             Margin="5,0"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompactNavigationItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsTabStop="True"
                             KeyboardNavigation.TabNavigation="Local"
                             AutomationProperties.Name="QuietShield feature navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="30"
                                      ToolTip="{Binding Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=Foreground}"
                                               Text="{Binding Glyph}" />

                                    <TextBlock Grid.Column="1"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.IsNavigationExpanded, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Margin="8"
                            Style="{StaticResource SidebarInfoCardStyle}">
                        <Grid>
                            <StackPanel Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="1,1,7,0"
                                             VerticalAlignment="Center"
                                             Fill="{StaticResource InformationBrush}" />
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="QuietShield Service" />
                                </StackPanel>
                                <TextBlock Margin="15,3,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding ServiceInstallationStatus}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{StaticResource InformationBrush}"
                                       Text="&#xE73E;"
                                       ToolTip="{Binding ServiceInstallationStatus}"
                                       Visibility="{Binding IsNavigationCompact, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <controls:ResponsivePageShell x:Name="PageShell"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="18,6,18,14"
                                          Title="{Binding SelectedPage.Title}"
                                          Description="{Binding SelectedPage.Description}"
                                          StatusText="{Binding SelectedPage.Status}">
                <controls:ResponsivePageShell.PageContent>
                    <Grid>
                        <pages:DashboardPage Visibility="{Binding IsDashboard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:ProgramConnectionLockPage Visibility="{Binding IsProgramConnectionLock, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:ProtectionProfilesPage Visibility="{Binding IsProtectionProfiles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:SchedulesPage Visibility="{Binding IsSchedules, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:CompatibilityGuardPage Visibility="{Binding IsCompatibilityGuard, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:DnsProtectionPage Visibility="{Binding IsDnsProtection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:DnsListsPage Visibility="{Binding IsDnsLists, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <pages:FoundationStatusPages />
                    </Grid>
                </controls:ResponsivePageShell.PageContent>
            </controls:ResponsivePageShell>
        </Grid>
    </Border>
</Window>
