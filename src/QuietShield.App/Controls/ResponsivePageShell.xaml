<UserControl x:Class="QuietShield.App.Controls.ResponsivePageShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,1,0,0" MaxWidth="900" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Description, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Top" Style="{StaticResource GlassPillStyle}" Visibility="{Binding StatusText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock MaxWidth="150" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource InformationBrush}" Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" TextWrapping="Wrap" />
            </Border>
        </Grid>
        <ScrollViewer x:Name="PageScroller" Grid.Row="1" Background="Transparent" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" PanningMode="None" Focusable="False">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{Binding PageContent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        </ScrollViewer>
    </Grid>
</UserControl>
