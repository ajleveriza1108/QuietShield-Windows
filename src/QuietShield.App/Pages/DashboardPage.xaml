<UserControl x:Class="QuietShield.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuietShield.App.Controls"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="DashboardEyebrowTextStyleR364"
               TargetType="TextBlock"
               BasedOn="{StaticResource EyebrowTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>    </UserControl.Resources>

    <Grid MinHeight="0" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="INTERNET MODE" />
                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InformationBrush}"
                                   Text="{Binding OperatingModeDisplay, Mode=OneWay}" />
                        <TextBlock Margin="12,3,0,0"
                                   MaxWidth="650"
                                   FontSize="10.5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding DataSavingPlanSummary, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button MinWidth="100"
                            Margin="0,0,6,0"
                            Style="{StaticResource DataSavingModeButtonStyle}"
                            Command="{Binding UseDataSavingModeCommand}"
                            Content="Data Saving" />
                    <Button MinWidth="90"
                            Style="{StaticResource WiFiModeButtonStyle}"
                            Command="{Binding UseWiFiModeCommand}"
                            Content="Wi-Fi" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource HeroCardStyle}">
            <Grid MinHeight="124">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="245" />
                </Grid.ColumnDefinitions>

                <Button Width="70"
                        Height="70"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource ProtectionLogoButtonStyle}"
                        Command="{Binding ProtectionToggleCommand}"
                        ToolTip="{Binding ProtectionToggleHint, Mode=OneWay}">
                    <Image RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Width="58"
                           Height="58"
                           Stretch="Uniform"
                           Source="/QuietShield.App;component/Assets/QuietShield_UI.png" />
                </Button>

                <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="QUIETSHIELD PROTECTION" />
                        <Border Margin="8,0,0,0"
                                Padding="6,1"
                                Background="#5A10233B"
                                BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock FontSize="8"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InformationBrush}"
                                       Text="{Binding ConsumerProtectionStateLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,3,0,0"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="{Binding ConsumerProtectionHeadline, Mode=OneWay}" />

                    <TextBlock Margin="0,3,0,0"
                               MaxWidth="760"
                               FontSize="10.5"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding ConsumerProtectionDetail, Mode=OneWay}"
                               TextWrapping="Wrap" />

                    <WrapPanel Margin="0,8,0,0">
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenProgramLockPageCommand}"
                                Content="App Lock" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenDataSavingPageCommand}"
                                Content="Data Saving"
                                Visibility="{Binding QuickDataSaving, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenPrivateBrowserPageCommand}"
                                Content="Private Browser"
                                Visibility="{Binding QuickPrivateBrowser, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenFileSafetyPageCommand}"
                                Content="File Safety"
                                Visibility="{Binding QuickFileSafety, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenActivityPageCommand}"
                                Content="Activity"
                                Visibility="{Binding QuickActivity, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenDnsProtectionPageCommand}"
                                Content="DNS"
                                Visibility="{Binding QuickDns, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="0,0,5,4"
                                Padding="9,4"
                                Style="{StaticResource CompactActionButtonStyle}"
                                Command="{Binding OpenSettingsPageCommand}"
                                Content="Settings"
                                Visibility="{Binding QuickSettings, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="10"
                        Background="#5A10233B"
                        BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="MASTER CONTROL" />
                        <Button Margin="0,6,0,0"
                                Command="{Binding ProtectionToggleCommand}"
                                Content="{Binding ProtectionToggleLabel, Mode=OneWay}" />
                        <Button Margin="0,6,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshConsumerProtectionCommand}"
                                Content="Refresh" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="8"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding ConsumerLastAction, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   MaxHeight="34"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <controls:AdaptiveGridPanel Grid.Row="2"
                                    Margin="0,8,0,0"
                                    ItemMinWidth="165"
                                    MaximumColumns="4"
                                    Spacing="8">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="PROGRAMS" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InformationBrush}"
                               Text="{Binding ApplicationCount, Mode=OneWay}" />
                    <TextBlock FontSize="8"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding LastDiscovery, Mode=OneWay}" />
                </StackPanel>
            </Border>

                        <Border Style="{StaticResource MetricCardStyle}"
                    ToolTip="Counts only verified QuietShield ad-block events; no estimates are shown.">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}"
                               Text="ADS BLOCKED" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetricValueStyle}"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{Binding AdsBlockedTodayR40}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding AdsBlockedStatusR40}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="WARNINGS" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding WarningCount, Mode=OneWay}" />
                    <TextBlock FontSize="8"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Current local notices" />
                </StackPanel>
            </Border>

                        <Border Style="{StaticResource MetricCardStyle}"
                    ToolTip="Counts only verified QuietShield tracker-block events; no estimates are shown.">
                <StackPanel>
                    <TextBlock Style="{StaticResource DashboardEyebrowTextStyleR364}"
                               Text="TRACKERS BLOCKED" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource MetricValueStyle}"
                               Foreground="{StaticResource InformationBrush}"
                               Text="{Binding TrackersBlockedTodayR40}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding TrackersBlockedStatusR40}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </controls:AdaptiveGridPanel>

        <Grid Grid.Row="3" Margin="0,8,0,8" MinHeight="0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.07*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,5,0"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="App Internet Control" />
                    <TextBlock Margin="0,9,0,0" Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="ACTIVE PROFILE" />
                    <TextBlock FontSize="10.5" Text="{Binding ProgramActivationActiveProfile, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="LAST GOOD" />
                    <TextBlock FontSize="10.5" Text="{Binding ProgramActivationLastKnownGood, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="TRANSACTION" />
                    <TextBlock FontSize="10.5" Text="{Binding ProgramActivationTransaction, Mode=OneWay}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenProgramLockPageCommand}"
                            Content="Open App Lock" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="5,0"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Current Activity" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="FIREWALL" />
                    <TextBlock FontSize="8" Text="{Binding FirewallSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource DashboardEyebrowTextStyleR364}" Text="DNS" />
                    <TextBlock FontSize="8" Text="{Binding DnsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="5,0,0,0"
                    MinHeight="0"
                    VerticalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Protection Layers" />
                    <TextBlock Margin="0,8,0,0" FontSize="10.5" Text="Program Connection Lock" Foreground="{StaticResource InformationBrush}" />
                    <TextBlock Margin="0,5,0,0" FontSize="10.5" Text="Windows Firewall" Foreground="{StaticResource InformationBrush}" />
                    <TextBlock Margin="0,5,0,0" FontSize="10.5" Text="DNS activation safety gate" Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Margin="0,5,0,0" FontSize="10.5" Text="Transaction recovery" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
