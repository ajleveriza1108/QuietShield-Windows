<UserControl x:Class="QuietShield.App.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuietShield.App.Controls"
             Focusable="False">
    <StackPanel>
        <Border Style="{StaticResource WarningBannerStyle}" AutomationProperties.Name="Protection inactive warning">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource WarningBrush}" Text="Protection is not activated" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="QuietShield Windows does not change Firewall, DNS, adapters, services, startup, or filtering settings in this foundation milestone." />
            </StackPanel>
        </Border>

        <controls:AdaptiveGridPanel x:Name="DashboardCardPanel" ItemMinWidth="230" MaximumColumns="3" Spacing="12">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="FOUNDATION" /><TextBlock Margin="0,7,0,0" Style="{StaticResource SectionTitleStyle}" Text="{Binding FoundationMode}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PROTECTION" /><TextBlock Margin="0,7,0,0" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource WarningBrush}" Text="{Binding ProtectionState}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="NETWORK TYPE" /><TextBlock Margin="0,7,0,0" Style="{StaticResource SectionTitleStyle}" Text="{Binding NetworkTypeSummary}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="METERED STATUS" /><TextBlock Margin="0,7,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding MeteredStatusSummary}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="FIREWALL - READ ONLY" /><TextBlock Margin="0,7,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding FirewallSummary}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DNS - READ ONLY" /><TextBlock Margin="0,7,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding DnsSummary}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DISCOVERED APPLICATIONS" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding ApplicationCount}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="LAST DISCOVERY" /><TextBlock Margin="0,7,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding LastDiscovery}" /></StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="WARNINGS" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding WarningCount}" /></StackPanel>
            </Border>
        </controls:AdaptiveGridPanel>

        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}" AutomationProperties.Name="Persistent service diagnostic status">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Persistent service foundation" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="Service installation and enforcement are not enabled. This panel uses only the local diagnostic IPC abstraction." />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="Phase 10B validated install/start, local IPC, Blocked and Allowed-on-All enforcement, rollback, restart recovery, and cleanup with the dedicated probe. Phase 11A now integrates that validated service status path into the desktop UI; customer activation remains gated." />
                <controls:AdaptiveGridPanel Margin="0,10,0,0" ItemMinWidth="220" MaximumColumns="3" Spacing="10">
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SERVICE INSTALLED" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceInstalled}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SERVICE RUNNING" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceRunning}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="IPC CONNECTED" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceIpcConnected}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PERSISTENT ENFORCEMENT AVAILABLE" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding PersistentEnforcementAvailable}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SERVICE STATUS" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceInstallationStatus}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="COMMUNICATION" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceCommunicationStatus}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PERSISTENT ENFORCEMENT" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource WarningBrush}" Text="{Binding PersistentEnforcementStatus}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ACTIVE PROFILE" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceActiveProfile}" TextWrapping="Wrap" ToolTip="{Binding ServiceActiveProfile}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="LAST-KNOWN-GOOD POLICY" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding LastKnownGoodPolicyStatus}" TextWrapping="Wrap" ToolTip="{Binding LastKnownGoodPolicyStatus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="TRANSACTION STATUS" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceTransactionStatus}" TextWrapping="Wrap" ToolTip="{Binding ServiceTransactionStatus}" /></StackPanel>
                    <StackPanel><TextBlock Style="{StaticResource EyebrowTextStyle}" Text="RECOVERY READINESS" /><TextBlock Margin="0,4,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ServiceRecoveryReadiness}" TextWrapping="Wrap" ToolTip="{Binding ServiceRecoveryReadiness}" /></StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PHASE 11 SERVICE STATUS" />
                        <Button Margin="0,5,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshServiceStatusCommand}"
                                Content="_Refresh Service Status"
                                ToolTip="Refresh the local QuietShield service status without installing, starting, or changing protection."
                                AutomationProperties.Name="Refresh Service Status" />
                    </StackPanel>
                </controls:AdaptiveGridPanel>
            </StackPanel>
        </Border>

        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Honest foundation status" />
                <TextBlock Margin="0,7,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="No blocked-ad, tracker, threat, bandwidth, or data-saved statistics are shown because no validated activity source exists." />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="{Binding TraySummary}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
