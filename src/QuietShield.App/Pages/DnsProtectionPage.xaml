<UserControl x:Class="QuietShield.App.Pages.DnsProtectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuietShield.App.Controls"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="10,7" Style="{StaticResource WarningBannerStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="10"
                           Text="{Binding DnsEnforcementBanner, Mode=OneWay}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource WarningBrush}"
                           Text="WINDOWS DNS CHANGES DISABLED" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="TEST DOMAIN" />
                    <TextBox Margin="0,5,0,0"
                             Text="{Binding DnsTestDomain, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="POLICY MODE" />
                    <ComboBox Margin="0,5,0,0"
                              ItemsSource="{Binding DnsProtectionModes}"
                              SelectedItem="{Binding SelectedDnsProtectionMode}" />
                </StackPanel>
                <Button Grid.Column="2"
                        MinWidth="100"
                        VerticalAlignment="Bottom"
                        Command="{Binding SimulateDnsCommand}"
                        Content="Test domain" />
            </Grid>
        </Border>

        <controls:AdaptiveGridPanel Grid.Row="2"
                                    Margin="0,8,0,0"
                                    ItemMinWidth="180"
                                    MaximumColumns="4"
                                    Spacing="8">
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DECISION" />
                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding DnsDecision, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CATEGORY" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding DnsCategory, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="MATCH" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding DnsMatchedRule, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="REASON" />
                    <TextBlock Margin="0,4,0,0" FontSize="10" Text="{Binding DnsReason, Mode=OneWay}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </controls:AdaptiveGridPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Local Resolver" />
                    <TextBlock Margin="0,8,0,2" Style="{StaticResource EyebrowTextStyle}" Text="RUNTIME" />
                    <TextBlock FontSize="10" Text="{Binding DnsRuntimeStatus, Mode=OneWay}" />
                    <TextBlock Margin="0,7,0,2" Style="{StaticResource EyebrowTextStyle}" Text="UPSTREAM" />
                    <TextBlock FontSize="10" Text="{Binding DnsUpstreamHealthStatus, Mode=OneWay}" />
                    <TextBlock Margin="0,7,0,2" Style="{StaticResource EyebrowTextStyle}" Text="CURRENT WINDOWS DNS" />
                    <TextBlock FontSize="9" Text="{Binding DnsSummary, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button Margin="0,9,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding TestLocalDnsRuntimeCommand}"
                            Content="Test local resolver" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Safety Readiness" />
                    <TextBlock Margin="0,8,0,2" Style="{StaticResource EyebrowTextStyle}" Text="TRANSACTION" />
                    <TextBlock FontSize="10" Text="{Binding DnsTransactionReadiness, Mode=OneWay}" />
                    <TextBlock Margin="0,7,0,2" Style="{StaticResource EyebrowTextStyle}" Text="BACKUP" />
                    <TextBlock FontSize="10" Text="{Binding OriginalDnsBackupStatus, Mode=OneWay}" />
                    <TextBlock Margin="0,7,0,2" Style="{StaticResource EyebrowTextStyle}" Text="RECOVERY" />
                    <TextBlock FontSize="10" Text="{Binding EmergencyRecoveryStatus, Mode=OneWay}" />
                    <TextBlock Margin="0,7,0,2" Style="{StaticResource EyebrowTextStyle}" Text="ACTIVATION READINESS" />
                    <TextBlock FontSize="9" Foreground="{StaticResource WarningBrush}" Text="{Binding DnsRehearsalReadiness, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button Margin="0,9,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding PreviewDnsActivationPlanCommand}"
                            Content="Preview safe plan" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
