<UserControl x:Class="QuietShield.App.Pages.DataSavingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="PRIMARY OPERATING MODE" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding OperatingModeDisplay}" />
                    <TextBlock Margin="0,5,0,0"
                               MaxWidth="680"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding OperatingModeStatus}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               MaxWidth="760"
                               FontSize="10"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding DataSavingEnforcementStatus}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Button MinWidth="145"
                            Margin="0,0,0,7"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding UseDataSavingModeCommand}"
                            Content="Data Saving" />
                    <Button MinWidth="145"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding UseWiFiModeCommand}"
                            Content="Wi-Fi Mode" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PROFILE NAME" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding DataSavingProfileName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="NETWORK" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding NetworkClassifications}"
                              SelectedItem="{Binding SelectedNetworkClassification}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CURRENT PLAN" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding DataSavingPlanSummary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="3"
                        MinWidth="120"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding SaveDataSavingProfileCommand}"
                        Content="Save Profile" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Applications" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Choose user applications that may use internet in Data Saving. Windows system components are protected in this test build." />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#FFFF6B6B"
                               Text="RED = WINDOWS SYSTEM" />
                </Grid>

                <ListBox Grid.Row="1"
                         Margin="0,10,0,0"
                         ItemsSource="{Binding DataSavingApplications}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="10,8"
                                    Background="#3614283E"
                                    CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource PrimaryTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSystemComponent}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="#FFFF6B6B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding ApplicationTypeLabel}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFF6B6B"
                                                   Text="{Binding SafetyLabel}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding AccessLabel}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="2"
                                              Margin="14,0,2,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                              IsEnabled="{Binding CanUserChangeAccess}"
                                              Content="Allow" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
