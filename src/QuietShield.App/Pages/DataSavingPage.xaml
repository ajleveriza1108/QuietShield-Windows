<UserControl x:Class="QuietShield.App.Pages.DataSavingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="MODE" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InformationBrush}"
                               Text="{Binding OperatingModeDisplay, Mode=OneWay}" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="9"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding OperatingModeStatus, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="PROFILE" />
                    <TextBox Margin="0,5,0,0"
                             Text="{Binding DataSavingProfileName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="NETWORK" />
                    <ComboBox Margin="0,5,0,0"
                              ItemsSource="{Binding NetworkClassifications}"
                              SelectedItem="{Binding SelectedNetworkClassification}" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource DataSavingModeButtonStyle}" MinWidth="94"
                            Margin="0,0,6,0"
                            Command="{Binding UseDataSavingModeCommand}"
                            Content="Data Saving" />
                    <Button MinWidth="88"
                            Margin="0,0,6,0"
                            Style="{StaticResource WiFiModeButtonStyle}"
                            Command="{Binding UseWiFiModeCommand}"
                            Content="Wi-Fi" />
                    <Button MinWidth="86"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveDataSavingProfileCommand}"
                            Content="Save" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,8"
                Padding="10,8"
                Background="#4D14283E"
                BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Margin="0,0,8,0"
                         Text="{Binding DataSavingSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search applications"
                         AutomationProperties.Name="Search Data Saving applications" />

                <ComboBox Grid.Column="1"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding DataSavingFilterOptions}"
                          SelectedItem="{Binding SelectedDataSavingFilter}" />

                <Button Grid.Column="2"
                        Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AllowVisibleDataSavingAppsCommand}"
                        Content="Allow visible" />
                <Button Grid.Column="3"
                        Margin="0,0,6,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding BlockVisibleDataSavingAppsCommand}"
                        Content="Block visible" />
                <Button Grid.Column="4"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RestoreDataSavingDefaultsCommand}"
                        Content="Reset" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Applications" />
                        <CheckBox Margin="0,5,0,0"
                                  IsChecked="{Binding ShowSystemDataSavingApplications, Mode=TwoWay}"
                                  Content="Show Windows system components"
                                  ToolTip="{Binding DataSavingSystemVisibilityNotice, Mode=OneWay}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding DataSavingPlanSummary, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="9"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="System components remain protected even when shown. Blocking a user app may interrupt its online features."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{StaticResource WarningBrush}"
                               Text="System apps stay protected" />
                </Grid>

                <ListBox Grid.Row="1"
                         Margin="0,8,0,0"
                         ItemsSource="{Binding DataSavingApplicationsView}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1" MinHeight="43">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="195" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSystemComponent}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFF6B6B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding ApplicationTypeLabel}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}"
                                               Text="{Binding SafetyLabel}" />
                                    <TextBlock FontSize="9"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding AccessLabel}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <CheckBox Unchecked="AllowInternetCheckBox_Unchecked" Grid.Column="2"
                                          Margin="12,0,2,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding IsAllowed, Mode=TwoWay}"
                                          IsEnabled="{Binding CanUserChangeAccess, Mode=OneWay}"
                                          Content="Allow" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
