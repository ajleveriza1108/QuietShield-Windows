<UserControl x:Class="QuietShield.App.Pages.DnsListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,9"
                Padding="11,8"
                Background="{StaticResource InformationSurfaceBrush}"
                BorderBrush="#365F80"
                BorderThickness="1"
                CornerRadius="9">
            <TextBlock FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Simulation only â€” entries stay in memory; Windows DNS and network settings remain unchanged."
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource ConceptCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Custom allowlist and blocklist" />
                    <TextBox x:Name="CustomDnsSearchBox"
                             Grid.Column="1"
                             MinWidth="240"
                             Text="{Binding CustomDnsSearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search entries"
                             AutomationProperties.Name="Search custom DNS entries" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#8A0D1929"
                            BorderBrush="{StaticResource GlassStrokeSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <Grid>
                            <ListBox MinHeight="255"
                                     ItemsSource="{Binding CustomDnsEntries}"
                                     SelectedItem="{Binding SelectedCustomDnsEntry}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     IsTabStop="True"
                                     AutomationProperties.Name="Custom DNS simulation entries">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TrimmedValueTextStyle}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DomainPattern}"
                                                           ToolTip="{Binding DomainPattern}" />
                                                <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               Text="{Binding ListKind}" />
                                                    <TextBlock Margin="7,0,0,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="{Binding MatchKind}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{StaticResource WarningBrush}"
                                                       Text="Protected"
                                                       Visibility="{Binding ParentProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="18"
                                       Style="{StaticResource ExplanatoryTextStyle}"
                                       Text="No custom simulation entries."
                                       Visibility="{Binding CustomDnsEntries, Converter={StaticResource EmptyCollectionToVisibilityConverter}}"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Margin="0,0,0,3"
                                       Style="{StaticResource ExplanatoryTextStyle}"
                                       Text="Domain or safe wildcard" />
                            <TextBox Text="{Binding CustomDnsDomain, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Custom DNS domain" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Margin="0,0,0,3"
                                           Style="{StaticResource ExplanatoryTextStyle}"
                                           Text="List" />
                                <ComboBox ItemsSource="{Binding CustomDomainListKinds}"
                                          SelectedItem="{Binding SelectedCustomListKind}"
                                          AutomationProperties.Name="Custom DNS list" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,3"
                                           Style="{StaticResource ExplanatoryTextStyle}"
                                           Text="Matching" />
                                <ComboBox ItemsSource="{Binding DnsRuleMatchKinds}"
                                          SelectedItem="{Binding SelectedCustomMatchKind}"
                                          AutomationProperties.Name="Custom DNS matching" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <TextBlock Margin="0,0,0,3"
                                       Style="{StaticResource ExplanatoryTextStyle}"
                                       Text="Notes" />
                            <TextBox MinHeight="54"
                                     MaxHeight="72"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxLength="500"
                                     Text="{Binding CustomDnsNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Custom DNS notes" />
                        </StackPanel>

                        <CheckBox Grid.Row="3"
                                  Margin="0,7,0,6"
                                  IsChecked="{Binding CustomDnsParentProtected}"
                                  Content="_Parent protected" />

                        <WrapPanel Grid.Row="4"
                                   KeyboardNavigation.TabNavigation="Local">
                            <Button Margin="0,0,7,0"
                                    Command="{Binding AddCustomDnsCommand}"
                                    Content="_Add" />
                            <Button Margin="0,0,7,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding EditCustomDnsCommand}"
                                    Content="_Edit selected" />
                            <Button Margin="0,0,7,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RemoveCustomDnsCommand}"
                                    Content="_Remove selected" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearDnsDecisionCacheCommand}"
                                    Content="_Clear cache" />
                        </WrapPanel>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2"
                           Margin="0,8,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding CustomDnsStatus}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
