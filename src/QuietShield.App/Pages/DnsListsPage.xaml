<UserControl x:Class="QuietShield.App.Pages.DnsListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuietShield.App.Controls"
             Focusable="False">
    <StackPanel>
        <Border Style="{StaticResource InformationBannerStyle}">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Entries on this page affect in-memory policy simulation only. Windows DNS and network settings remain unchanged." />
        </Border>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Custom allowlist and blocklist" />
                <Label Margin="0,9,0,3" Padding="0" Foreground="{StaticResource SecondaryTextBrush}" Content="_Search entries" Target="{Binding ElementName=CustomDnsSearchBox}" />
                <TextBox x:Name="CustomDnsSearchBox" Text="{Binding CustomDnsSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search custom DNS entries" />
                <controls:AdaptiveGridPanel Margin="0,11,0,0" ItemMinWidth="310" MaximumColumns="2" Spacing="14">
                    <Grid>
                        <ListBox MinHeight="220"
                                 MaxHeight="340"
                                 ItemsSource="{Binding CustomDnsEntries}"
                                 SelectedItem="{Binding SelectedCustomDnsEntry}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 IsTabStop="True"
                                 AutomationProperties.Name="Custom DNS simulation entries">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontWeight="SemiBold" Text="{Binding DomainPattern}" ToolTip="{Binding DomainPattern}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding ListKind}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding MatchKind}" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" Text="Parent protected" Visibility="{Binding ParentProtected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" Style="{StaticResource ExplanatoryTextStyle}" Text="No custom simulation entries." Visibility="{Binding CustomDnsEntries, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" IsHitTestVisible="False" />
                    </Grid>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Domain or safe wildcard" />
                        <TextBox Text="{Binding CustomDnsDomain, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom DNS domain" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="List" />
                        <ComboBox ItemsSource="{Binding CustomDomainListKinds}" SelectedItem="{Binding SelectedCustomListKind}" AutomationProperties.Name="Custom DNS list" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Matching" />
                        <ComboBox ItemsSource="{Binding DnsRuleMatchKinds}" SelectedItem="{Binding SelectedCustomMatchKind}" AutomationProperties.Name="Custom DNS matching" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Notes" />
                        <TextBox MaxLength="500" Text="{Binding CustomDnsNotes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom DNS notes" />
                        <CheckBox Margin="0,8,0,8" IsChecked="{Binding CustomDnsParentProtected}" Content="_Parent protected" />
                        <WrapPanel KeyboardNavigation.TabNavigation="Local">
                            <Button Margin="0,0,8,8" Command="{Binding AddCustomDnsCommand}" Content="_Add" />
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding EditCustomDnsCommand}" Content="_Edit selected" />
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveCustomDnsCommand}" Content="_Remove selected" />
                            <Button Margin="0,0,8,8" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearDnsDecisionCacheCommand}" Content="_Clear decision cache" />
                        </WrapPanel>
                    </StackPanel>
                </controls:AdaptiveGridPanel>
                <TextBlock Margin="0,10,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding CustomDnsStatus}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
