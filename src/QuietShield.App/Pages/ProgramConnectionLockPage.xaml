<UserControl x:Class="QuietShield.App.Pages.ProgramConnectionLockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,8"
                Padding="10,7"
                Style="{StaticResource InformationBannerStyle}">
            <TextBlock FontSize="10"
                       Text="Choose an exact installed user app, then Block or Allow on All through the validated QuietShield service."
                       TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ConceptCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Applications" />
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding ShowSystemAndUnsupportedApplications}"
                                  Content="Show Windows system and unsupported apps"
                                  ToolTip="Protected Windows system components remain non-blockable. Unsupported entries are shown for inspection only." />
                    </Grid>

                    <TextBox Grid.Row="1"
                             Margin="0,8,0,8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search applications" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Applications}"
                              SelectedItem="{Binding SelectedApplication}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2" MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="17"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="&#xE7B8;" />
                                        <Image Width="24" Height="24" Source="{Binding IconImage}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="9"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   Text="{Binding Publisher}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="9"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding PathStatus}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ConceptCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Internet Access" />

                    <TextBlock Margin="0,9,0,2" Style="{StaticResource EyebrowTextStyle}" Text="APP" />
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding PersistentWorkflowApplication, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PersistentWorkflowApplication, Mode=OneWay}" />

                    <TextBlock Margin="0,9,0,2" Style="{StaticResource EyebrowTextStyle}" Text="RULE" />
                    <ComboBox ItemsSource="{Binding PersistentProgramPolicies}"
                              SelectedItem="{Binding SelectedPolicy}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="9"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Blocked and AllowedOnAll are the real persistent test choices." />

                    <Button Margin="0,10,0,0"
                            Click="ApplyAppRuleButton_Click"
                            Content="Apply app rule" />

                    <TextBlock Margin="0,8,0,0"
                               FontSize="10"
                               Text="{Binding PersistentWorkflowMessage, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="9"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding PersistentWorkflowIssue, Mode=OneWay}"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,10,0,8" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="SERVICE" />
                            <TextBlock FontSize="10">
                                <Run Text="{Binding ServiceRunning, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding ServiceIpcConnected, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="ENFORCEMENT" />
                            <TextBlock FontSize="10"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Text="{Binding PersistentEnforcementAvailable, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Button Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RetryPersistentServiceConnectionCommand}"
                            Content="Retry service" />

                    <Expander Margin="0,10,0,0" Header="Advanced details">
                        <StackPanel Margin="0,7,0,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="WORKFLOW" />
                            <TextBlock FontSize="9" Text="{Binding PersistentWorkflowState, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource EyebrowTextStyle}" Text="TRANSACTION" />
                            <TextBlock FontSize="9" Text="{Binding TransactionReadiness, Mode=OneWay}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource EyebrowTextStyle}" Text="ROLLBACK" />
                            <TextBlock FontSize="9" Text="{Binding RollbackReadiness, Mode=OneWay}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Margin="0,0,6,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PreviewEnforcementPlanCommand}"
                                        Content="Preview" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ExportEnforcementPlanCommand}"
                                        Content="Export" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
