<UserControl x:Class="QuietShield.App.Pages.ProgramConnectionLockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuietShield.App.Controls"
             Focusable="False">
    <StackPanel>
        <Border Style="{StaticResource InformationBannerStyle}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="SIMULATION ONLY — no Windows rule is applied" />
                <TextBlock Margin="0,5,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="Program identities come from the existing read-only inventory. Firewall and WFP plans are explanatory and cannot execute." />
            </StackPanel>
        </Border>
        <controls:AdaptiveGridPanel ItemMinWidth="340" MaximumColumns="2" Spacing="14">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Searchable application inventory" />
                    <Label Margin="0,9,0,3" Padding="0" Foreground="{StaticResource SecondaryTextBrush}" Content="_Search applications" Target="{Binding ElementName=ApplicationSearchBox}" />
                    <TextBox x:Name="ApplicationSearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search installed applications" />
                    <Grid Margin="0,10,0,0">
                        <ListView x:Name="ApplicationInventoryList" MinHeight="250" MaxHeight="410"
                                  ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" IsTabStop="True"
                                  AutomationProperties.Name="Read-only virtualized application inventory">
                            <ListView.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="72">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource AccentBrush}" Text="&#xE7B8;" ToolTip="No extractable icon was available" />
                                            <Image Width="28" Height="28" Source="{Binding IconImage}" ToolTip="{Binding IconSourcePath}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontWeight="SemiBold" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Text="{Binding Publisher}" ToolTip="{Binding Publisher}" />
                                            <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PathValue}" ToolTip="{Binding PathValue}" />
                                            <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ApplicationTypeLabel}" ToolTip="{Binding PathStatus}" />
                                            <TextBlock Style="{StaticResource TrimmedValueTextStyle}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PolicyLabel}" ToolTip="{Binding PolicyLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18" Style="{StaticResource ExplanatoryTextStyle}" Text="No matching applications were found. Discovery remains read-only." Visibility="{Binding Applications, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Deterministic policy simulator" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Active profile" />
                        <ComboBox ItemsSource="{Binding ConnectionProfiles}" SelectedItem="{Binding SelectedConnectionProfile}" DisplayMemberPath="Name" AutomationProperties.Name="Active simulated protection profile" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Connection type" />
                        <ComboBox ItemsSource="{Binding ConnectionTypes}" SelectedItem="{Binding SelectedConnectionType}" AutomationProperties.Name="Connection type" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Program policy override" />
                        <ComboBox ItemsSource="{Binding ProgramPolicies}" SelectedItem="{Binding SelectedPolicy}" AutomationProperties.Name="Program connection policy" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Temporary allowance" />
                        <ComboBox ItemsSource="{Binding TemporaryAllowanceOptions}" SelectedItem="{Binding SelectedTemporaryAllowance}" AutomationProperties.Name="Temporary allowance duration" />
                        <TextBlock Margin="0,10,0,4" Style="{StaticResource ExplanatoryTextStyle}" Text="Compatibility Guard" />
                        <ComboBox ItemsSource="{Binding CompatibilityOptions}" SelectedItem="{Binding SelectedCompatibilityOption}" AutomationProperties.Name="Compatibility exclusion preview" />
                        <CheckBox Margin="0,9,0,0" IsChecked="{Binding IsParentProtectedSimulation}" Content="Require _parent approval in this simulation" AutomationProperties.Name="Require parent approval simulation" />
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionTitleStyle}" Foreground="{StaticResource AccentBrush}" Text="{Binding SimulationDecision}" ToolTip="{Binding SimulationDecision}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding SimulationReason}" ToolTip="{Binding SimulationReason}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </controls:AdaptiveGridPanel>
        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Decision evidence and future enforcement plan" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding IdentitySummary}" ToolTip="{Binding IdentitySummary}" />
                <TextBlock Margin="0,7,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="{Binding DecisionEvidence}" ToolTip="{Binding DecisionEvidence}" />
                <TextBlock Margin="0,7,0,0" Style="{StaticResource ExplanatoryTextStyle}" Text="{Binding PlannerSummary}" ToolTip="{Binding PlannerSummary}" />
                <TextBlock Margin="0,9,0,0" Style="{StaticResource ExplanatoryTextStyle}" Foreground="{StaticResource WarningBrush}" Text="There is intentionally no Apply, Activate, or Enforce control. Every plan has CanExecute=false." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
