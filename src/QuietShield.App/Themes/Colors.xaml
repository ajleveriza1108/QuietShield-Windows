<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#0B1118</Color>
    <Color x:Key="NavigationBackgroundColor">#101923</Color>
    <Color x:Key="SurfaceColor">#15212D</Color>
    <Color x:Key="SurfaceRaisedColor">#1B2A38</Color>
    <Color x:Key="SurfaceInteractiveColor">#213342</Color>
    <Color x:Key="AccentColor">#48D1B5</Color>
    <Color x:Key="AccentSoftColor">#203F3E</Color>
    <Color x:Key="PrimaryTextColor">#F4F8FA</Color>
    <Color x:Key="SecondaryTextColor">#B7C7D2</Color>
    <Color x:Key="MutedTextColor">#91A6B4</Color>
    <Color x:Key="WarningColor">#FFD37A</Color>
    <Color x:Key="WarningSurfaceColor">#3A3021</Color>
    <Color x:Key="DangerColor">#FFB2B8</Color>
    <Color x:Key="DangerSurfaceColor">#3A2426</Color>
    <Color x:Key="SuccessColor">#81E6C7</Color>
    <Color x:Key="SuccessSurfaceColor">#183A32</Color>
    <Color x:Key="InformationColor">#8DCBFF</Color>
    <Color x:Key="InformationSurfaceColor">#1A3145</Color>
    <Color x:Key="DisabledTextColor">#718490</Color>
    <Color x:Key="DisabledSurfaceColor">#17212A</Color>
    <Color x:Key="DividerColor">#304452</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{StaticResource NavigationBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceInteractiveBrush" Color="{StaticResource SurfaceInteractiveColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="InformationBrush" Color="{StaticResource InformationColor}" />
    <SolidColorBrush x:Key="InformationSurfaceBrush" Color="{StaticResource InformationSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
</ResourceDictionary>
